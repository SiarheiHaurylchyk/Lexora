# -----------------------------------------------------------------------------
# Jitsi Meet (Docker) — скопируйте в .env и заполните.
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)
#
# Полный список переменных:
#   https://github.com/jitsi/docker-jitsi-meet/blob/master/env.example
# -----------------------------------------------------------------------------

# Куда складывается сгенерированный конфиг (относительно папки infra/jitsi)
CONFIG=./jitsi-meet-cfg

TZ=UTC

# Обязательно: публичный URL без завершающего слэша (как его видят браузеры и Lexora)
# Прод:   PUBLIC_URL=https://meet.vash-domen.ru
# Локально (HTTP, только для теста): см. блок ниже в README
PUBLIC_URL=https://meet.example.com

HTTP_PORT=8000
HTTPS_PORT=8443

# Образы (фиксируйте версию в проде)
JITSI_IMAGE_VERSION=stable-9584
RESTART_POLICY=unless-stopped

# --- Обязательные пароли сервисов (уникальные, не копируйте из примера) ---
# Сгенерировать: см. README (openssl / PowerShell).
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=

# --- Lexora / встраивание (совпадает с JitsiMeetEmbed во фронте) ---
DISABLE_DEEP_LINKING=1
ENABLE_PREJOIN_PAGE=0
ENABLE_WELCOME_PAGE=0
ENABLE_CLOSE_PAGE=0
ENABLE_GUESTS=1
ENABLE_AUTH=0

# Запись на сервере и Jibri не используются в базовом сценарии Lexora
ENABLE_RECORDING=0

# Let's Encrypt (прод с HTTPS на 443). Для локального HTTP отключите и см. README.
ENABLE_LETSENCRYPT=0
# ENABLE_LETSENCRYPT=1
# LETSENCRYPT_DOMAIN=meet.example.com
# LETSENCRYPT_EMAIL=you@example.com
# ENABLE_HTTP_REDIRECT=1

# Если за NAT / без белого IP — укажите публичный IPv4 сервера (через запятую можно несколько)
# JVB_ADVERTISE_IPS=203.0.113.50

# Внутренние имена стека (обычно не меняют)
XMPP_DOMAIN=meet.jitsi
XMPP_SERVER=xmpp.meet.jitsi
