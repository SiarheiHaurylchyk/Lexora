# Локальный стек Lexora + Jitsi (docker compose из корня репозитория).
# Не использовать в продакшене — зафиксированные пароли сервисов только для dev.
#
# HTTP на :8000 — Lexora (http://localhost:3000) встраивает звонок через обычный iframe,
# без External API / без загрузки https://…/external_api.js (иначе часто падает на самоподписанном TLS).
#
# Lexora: http://localhost:3000  |  Jitsi: http://localhost:8000

TZ=UTC
# Без схемы: шаблоны JVB вычитают только "https://"; при http://… в PUBLIC_URL ломается domain в jvb.conf.
# Клиентские bosh/ws для HTTP: см. infra/jitsi/http-local-custom-config.js (монтируется в /config/custom-config.js).
PUBLIC_URL=localhost:8000
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0
HTTP_PORT=8000
HTTPS_PORT=8443

DISABLE_DEEP_LINKING=1
ENABLE_PREJOIN_PAGE=0
ENABLE_WELCOME_PAGE=0
ENABLE_CLOSE_PAGE=0
ENABLE_GUESTS=1
ENABLE_AUTH=0
ENABLE_RECORDING=0

XMPP_DOMAIN=meet.jitsi
XMPP_SERVER=xmpp.meet.jitsi

JICOFO_AUTH_PASSWORD=7c4a8f09e1d2b5639483726150493f2a
JVB_AUTH_PASSWORD=8d5b9e10f2e3c674059483726160504f
JIGASI_XMPP_PASSWORD=9e6caf21f304d785160594837271615f
JIBRI_RECORDER_PASSWORD=af7dbe32f415e8962716059483827261
JIBRI_XMPP_PASSWORD=b08ecf43f526f9a73827170605949383

JICOFO_REST_PORT=8888
JVB_PORT=10000
