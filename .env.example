# Ollama в Docker по-прежнему только с профилем: COMPOSE_PROFILES=ollama или docker compose --profile ollama up -d

# Чат: xai | groq | ollama | deepseek | mock  (alias LEXORA_AI_PROVIDER=grok → xAI)
LEXORA_AI_PROVIDER=xai
# Ключ только из https://console.x.ai/ → API Keys (обычно начинается с xai-). Одна строка, БЕЗ кавычек.
XAI_API_KEY=

# true (по умолчанию): чат/озвучка/Whisper только для залогиненных пользователей Lexora (JWT).
# false: POST /api/ai/chat|speech|transcribe без JWT — только для локальных тестов; любой может расходовать ваши API-ключи.
# LEXORA_AI_REQUIRE_LOGIN=false
# Модель Grok: см. https://docs.x.ai/docs/models — например grok-4.3
# XAI_CHAT_MODEL=grok-4.3
# XAI_CHAT_MAX_OUTPUT_TOKENS=8192
# Голос озвучки (eve, ara, leo, rex, sal или свой из Voice Library):
# XAI_TTS_VOICE=eve
# XAI_TTS_VOICE_RU=

# Микрофон: Groq Whisper (русская речь стабильнее браузерного STT). Ключ: https://console.groq.com — gsk_...
GROQ_API_KEY=

# Если чат на Groq вместо xAI:
# LEXORA_AI_PROVIDER=groq

# Чат DeepSeek (облако, OpenAI-совместимый API) или свой сервер (LM Studio / vLLM):
# LEXORA_AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# Локально: DEEPSEEK_API_URL=http://host.docker.internal:1234/v1/chat/completions и ключ, если требует прокси

# Локально бесплатно (open-weight): Ollama на хосте или в Docker:
#   docker compose --profile ollama up -d
#   LEXORA_AI_PROVIDER=ollama
#   OLLAMA_BASE_URL=http://ollama:11434
#   OLLAMA_MODEL=llama3.2
#   docker exec -it lexora-ollama ollama pull llama3.2

# Озвучка /ai: при XAI_API_KEY — xAI TTS (MP3/WAV, русский поддерживается); иначе при LEXORA_AI_PROVIDER=groq и GROQ_API_KEY — Groq Orpheus.
